# =============================================================================
# WA Live Count — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your actual values.
# WhatsApp session credentials are stored in ./auth/ — NOT here.

# Cloudflare Turnstile CAPTCHA Keys (Get these from Cloudflare Dashboard)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key

# Optional: Override the port the Next.js dev server listens on (default: 3000)
# PORT=3000

# Optional: Increase Node.js memory for long-running Baileys socket
# NODE_OPTIONS=--max-old-space-size=512
