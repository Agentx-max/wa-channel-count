# Copy this file to .env.local and fill in the values.
# WhatsApp session credentials are stored in ./auth/ — NOT here.

# Cloudflare Turnstile CAPTCHA Keys
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFE7AufdjdI47RVb
TURNSTILE_SECRET_KEY=0x4AAAAAAFE7Ar1uUgViPUZoQXvW8rfga1w

# Optional: Override the port the Next.js dev server listens on (default: 3000)
# PORT=3000

# Optional: Increase Node.js memory for long-running Baileys socket
# NODE_OPTIONS=--max-old-space-size=512
